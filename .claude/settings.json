  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"C:\\Users\\AlexAguilar\\WMS_Build\\.claude\\hooks\\guardrails.ps1\"",
            "timeout": 10
          }
        ]
      }
    ]
