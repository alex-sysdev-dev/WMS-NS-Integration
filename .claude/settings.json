      "mcp__NetSuite__ns_runCustomSuiteQL",
      "mcp__claude_ai_NetSuite__ns_getSuiteQLMetadata",
      "mcp__NetSuite__ns_getSuiteQLMetadata",
      "mcp__claude_ai_NetSuite__ns_listSavedSearches",
      "mcp__NetSuite__ns_listSavedSearches",
      "mcp__claude_ai_NetSuite__ns_runSavedSearch",
      "mcp__NetSuite__ns_runSavedSearch",
      "mcp__claude_ai_monday_com__get_board_items_page",
      "mcp__claude_ai_monday_com__get_updates",
      "mcp__claude_ai_monday_com__get_board_info",
