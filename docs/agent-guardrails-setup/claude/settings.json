{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "mcp__NetSuite__ns_createRecord",
      "mcp__NetSuite__ns_updateRecord",
      "mcp__claude_ai_NetSuite__ns_createRecord",
      "mcp__claude_ai_NetSuite__ns_updateRecord",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Write(./.env)",
      "Write(./.env.*)",
      "Write(./supabase/migrations/**)",
      "Edit(./supabase/migrations/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git filter-branch:*)",
      "Bash(supabase db push:*)",
      "Bash(npx supabase db push:*)",
      "Bash(rm -rf /:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Write(./supabase/**)",
      "Edit(./package.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"C:\\Users\\AlexAguilar\\WMS_Build\\.claude\\hooks\\guardrails.ps1\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
