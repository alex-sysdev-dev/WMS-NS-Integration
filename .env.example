# Optional. Sender address for password reset emails.
PASSWORD_RESET_FROM_EMAIL=
# Optional. Comma-separated account email to delivery inbox mappings for Resend testing limits.
PASSWORD_RESET_EMAIL_DELIVERY_OVERRIDES=
