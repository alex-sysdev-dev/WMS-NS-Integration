NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Local-only developer bypass for browsing protected pages without signing in. Ignored in production.
LOCAL_DEV_PLATFORM_ACCESS=false
